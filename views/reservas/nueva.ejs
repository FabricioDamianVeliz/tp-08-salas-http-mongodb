<h1><%= titulo %> - <%= seccion %></h1>

<% if (error) { %>
    <div class="alerta" role="alert">
        <%= error %>
    </div>
<% } %>

<form action="/reservas" method="post" class="tarjeta">
    <label for="estudiante">Nombre del estudiante:</label>
    <input type="text" id="estudiante" name="estudiante" value="<%= valores.estudiante || '' %>">

    <label for="email">Email de contacto:</label>
    <input type="email" id="email" name="email" value="<%= valores.email || '' %>">

    <label for="sala">Sala requerida:</label>
    <select id="sala" name="sala">
        <option value="Sala Norte" <%= valores.sala === 'Sala Norte' ? 'selected' : '' %>>Sala Norte</option>
        <option value="Sala Sur" <%= valores.sala === 'Sala Sur' ? 'selected' : '' %>>Sala Sur</option>
        <option value="Sala Multimedia" <%= valores.sala === 'Sala Multimedia' ? 'selected' : '' %>>Sala Multimedia</option>
    </select>

    <label for="fecha">Fecha:</label>
    <input type="date" id="fecha" name="fecha" value="<%= valores.fecha || '' %>">

    <label for="turno">Turno:</label>
    <select id="turno" name="turno">
        <option value="Mañana" <%= valores.turno === 'Mañana' ? 'selected' : '' %>>Mañana</option>
        <option value="Tarde" <%= valores.turno === 'Tarde' ? 'selected' : '' %>>Tarde</option>
        <option value="Noche" <%= valores.turno === 'Noche' ? 'selected' : '' %>>Noche</option>
    </select>

    <label for="personas">Cantidad de personas (1 a 6):</label>
    <input type="number" id="personas" name="personas" min="1" max="6" value="<%= valores.personas || '' %>">

    <br><br>
    <button type="submit" class="btn" style="width: 100%;">Confirmar Reserva</button>
</form>